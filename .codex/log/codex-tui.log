+      const next = { ...state.hotkeys };
+      delete next[id];
+      return { hotkeys: next };
+    });
+  },
+
+  triggerHotkey(combo) {
+    const binding = Object.values(get().hotkeys).find((item) => item.combo.toLowerCase() === combo.toLowerCase());
+    if (!binding) {
+      return false;
+    }
+    binding.handler();
+    set(() => ({ lastShortcut: combo }));
+    return true;
   }
