 def generate_version_id(tree_id: str) -> str:
     return f"{tree_id}::{uuid.uuid4().hex[:12]}"
+
+
+def ensure_acyclic(relations: Iterable[Tuple[str, str]]) -> None:
+    """Validate that the directed relation pairs do not form a cycle."""
+
+    graph: dict[str, set[str]] = {}
+    for source, target in relations:
+        if source == target:
+            raise ValidationFailure("Relation cannot reference the same node for both endpoints.")
+        graph.setdefault(source, set()).add(target)
+        graph.setdefault(target, set())
+
+    visited: set[str] = set()
+    visiting: set[str] = set()
+
+    def dfs(node: str) -> None:
+        if node in visiting:
+            raise ValidationFailure("Relations create a cycle; ensure direction flows from cause to effect.")
+        if node in visited:
+            return
+        visiting.add(node)
+        for neighbour in graph.get(node, ()):
+            dfs(neighbour)
+        visiting.remove(node)
+        visited.add(node)
+
+    for node in list(graph):
+        if node not in visited:
+            dfs(node)
 
 
