<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  `xcodebuild -exportArchive` options for the TestFlight job in
  .github/workflows/ios.yml. The job copies this file to $RUNNER_TEMP and adds
  `teamID` from vars.APPLE_TEAM_ID with `plutil -replace`; the team id is not
  committed. `destination: upload` sends the build straight to App Store
  Connect; the build number is the one CI archived with, never Xcode's.
-->
<plist version="1.0">
<dict>
	<key>destination</key>
	<string>upload</string>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
