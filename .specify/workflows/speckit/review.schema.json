{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "verdict",
    "summary",
    "reviewed_files",
    "findings",
    "product_decisions"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "requirements-consistency",
        "architecture-consistency",
        "testability-evidence",
        "adversarial-high-risk"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "changes-required", "product-decision-required"]
    },
    "summary": {"type": "string", "minLength": 1},
    "reviewed_files": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "category",
          "description",
          "evidence",
          "recommendation"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["blocking", "important", "advisory"]
          },
          "category": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "recommendation": {"type": "string", "minLength": 1}
        }
      }
    },
    "product_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "question",
          "why_needed",
          "options",
          "affected_acceptance"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "scope",
              "ux",
              "priority",
              "privacy",
              "permissions",
              "pricing",
              "safety-compliance",
              "acceptance-behavior"
            ]
          },
          "question": {"type": "string", "minLength": 1},
          "why_needed": {"type": "string", "minLength": 1},
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "string", "minLength": 1}
          },
          "affected_acceptance": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
