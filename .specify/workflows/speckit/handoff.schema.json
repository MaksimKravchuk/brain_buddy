{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrainBuddy Spec Kit to Hermes handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "root_outcome",
    "artifacts",
    "planning_review",
    "product_decisions",
    "lanes",
    "risks",
    "non_goals"
  ],
  "properties": {
    "schema_version": {"const": "speckit-hermes-handoff/v1"},
    "root_outcome": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spec", "plan", "tasks", "checklist", "adrs"],
      "properties": {
        "spec": {"type": "string", "minLength": 1},
        "plan": {"type": "string", "minLength": 1},
        "tasks": {"type": "string", "minLength": 1},
        "checklist": {"type": "string", "minLength": 1},
        "adrs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "planning_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "risk", "status", "reviewers"],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "risk": {"enum": ["low", "medium", "high"]},
        "status": {"enum": ["approved", "founder-accepted"]},
        "reviewers": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
        "human_signoff": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["approved_by", "approved_on", "run_id", "artifacts_digest", "rationale"],
          "properties": {
            "approved_by": {"type": "string", "minLength": 1},
            "approved_on": {"type": "string", "minLength": 1},
            "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
            "artifacts_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "rationale": {"type": "string", "minLength": 40}
          }
        },
        "founder_acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "accepted_by",
            "accepted_on",
            "expires_on",
            "rationale",
            "compensating_measures",
            "campaign_history"
          ],
          "properties": {
            "accepted_by": {"type": "string", "minLength": 1},
            "accepted_on": {"type": "string", "format": "date", "minLength": 10},
            "expires_on": {"type": "string", "format": "date", "minLength": 10},
            "rationale": {"type": "string", "minLength": 120},
            "compensating_measures": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 20}
            },
            "campaign_history": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["run_id", "status"],
                "properties": {
                  "run_id": {"type": "string", "minLength": 1},
                  "status": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "product_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "question", "answer", "evidence_ref"],
        "properties": {
          "category": {
            "enum": ["scope", "ux", "priority", "privacy", "permissions", "pricing", "safety-compliance", "acceptance-behavior"]
          },
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome", "depends_on", "task_refs", "scope_paths", "exclusive_writer_scope", "acceptance_evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
          "outcome": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "task_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "scope_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exclusive_writer_scope": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "acceptance_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
