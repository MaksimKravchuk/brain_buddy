{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "brainbuddy.pre-freeze-writer-receipt/v1",
  "title": "BrainBuddy writer-owned pre-freeze receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "implementation_sha", "inventory", "gates"],
  "properties": {
    "contract": {"const": "brainbuddy.pre-freeze-writer-receipt/v1"},
    "implementation_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "inventory": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "command", "observation", "evidence"],
        "properties": {
          "id": {"enum": ["writer.tests", "writer.verify_all", "writer.path_classification", "writer.diff_review"]},
          "status": {"enum": ["PASS", "NOT_APPLICABLE"]},
          "command": {"type": "string", "minLength": 1},
          "observation": {"type": "string", "minLength": 1},
          "evidence": {"type": "string", "minLength": 1},
          "justification": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
