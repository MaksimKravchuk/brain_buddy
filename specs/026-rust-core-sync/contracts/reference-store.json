 "contradictions": [
  {
   "id": "C-01",
   "topic": "Sharp s and full case folding in Smart Add resolution",
   "languages": {
    "web": "lower-case only (U+00DF stays)",
    "python": "casefold: ss",
    "swift": "ss (intentional, SmartAddWebParityTests)",
    "rust": "ss"
   },
   "evidence": [
    "web-presentation-vectors.json parse.divergence (sharp s)",
    "name_collision_probes WP-K-001, WP-K-003"
   ],
   "proposed_resolution": "Server rule is normative (smart-add.md: backend authoritative). Web keeps its optimistic helper until PR-53; the server re-resolves the sent name, so stored data is unaffected.",
   "status": "proposed"
  },
  {
   "id": "C-02",
   "topic": "Whitespace class",
   "languages": {
    "web": "JavaScript \\s: includes U+FEFF, excludes U+0085 and U+001C..U+001F",
    "python": "str.isspace: the reverse",
    "swift": "NameNormalizer follows Python; SmartAddParser deliberately follows JavaScript for token boundaries",
    "rust": "Python (normalization::is_space)"
   },
   "evidence": [
    "web-presentation-vectors.json name_collision_probes WP-K-008..010",
    "primitive-vectors.json whitespace WS-001..009"
   ],
   "proposed_resolution": "Rust uses the server class for names, titles and keys. Smart Add tokenization (not part of this slice) must keep the JavaScript class until the web helper is retired.",
   "status": "proposed"
  },
  {
   "id": "C-03",
   "topic": "Length limits",
   "languages": {
    "web": "UTF-16 code units (String.length)",
    "python": "Unicode scalars (pydantic max_length)",
    "swift": "Unicode scalars",
    "rust": "Unicode scalars"
   },
   "evidence": [
    "web-presentation-vectors.json parse divergence (300 emoji)",
    "primitive-vectors.json scalar_length SL-008"
   ],
   "proposed_resolution": "Scalars everywhere. The web composer rejects astral-heavy titles of 251..500 scalars that the server accepts; fix with PR-53 or accept.",
   "status": "proposed"
  },
  {
   "id": "C-04",
   "topic": "Leading @ on project names",
   "languages": {
    "web": "strips one leading @ before matching a project",
    "python": "normalize_task_name keeps @ in project keys (only tags strip it)",
    "swift": "kit planner mirrors the web when resolving; NameNormalizer.project keeps @",
    "rust": "project_key keeps @ (server rule)"
   },
   "evidence": [
    "primitive-vectors.json name_normalization NN-022..024, NN-031"
   ],
   "proposed_resolution": "Server rule is normative; the web strip is part of the legacy-sigil handling of the typed token, not of stored-name keys.",
   "status": "proposed"
  },
  {
   "id": "C-05",
   "topic": "Task search folding",
   "languages": {
    "python": "NFKC + casefold, no diacritic folding",
    "swift": "NFKC + case- and diacritic-insensitive (Eclair matches eclair), Character.isWhitespace for query collapse",
    "web": "server-side search",
    "rust": "search_key / search_query_key follow Python"
   },
   "evidence": [
    "ios Queries+Ordering.swift QueryText.fold",
    "backend service._normalize_for_search"
   ],
   "proposed_resolution": "Open product decision: the shared core cannot satisfy both. Rust implements the server rule; iOS local search currently matches more than the server does.",
   "status": "decision-needed"
  },
  {
   "id": "C-06",
   "topic": "Project and tag list ordering key",
   "languages": {
    "python": "name.strip().casefold() then id (no NFKC, no whitespace collapse, no @ strip)",
    "swift": "NameNormalizer key, then diacritic-folded, then display and id",
    "rust": "not ported in this slice"
   },
   "evidence": [
    "backend service.list_projects/list_tags",
    "ios Queries+Ordering.swift NameSortKey"
   ],
   "proposed_resolution": "Open: pick one ordering key before the list query moves into the core.",
   "status": "decision-needed"
  },
  {
   "id": "C-07",
   "topic": "Unicode data version",
   "languages": {
    "python": "3.14 = Unicode 16.0.0 (backend/Dockerfile python:3.14-slim; owner decision 2026-10-09 replaced 3.11 = Unicode 14.0)",
    "swift": "platform ICU/stdlib; folding exceptions table written for Unicode 14",
    "rust": "unicode-normalization =0.1.24 / caseless =0.2.2 / unicode-general-category =1.1.0 = Unicode 16.0.0 (0.1.25 is Unicode 17.0.0 and is not used)"
   },
   "evidence": [
    "exhaustive comparison of all 1 112 064 scalars with Python 3.14 (Unicode 16.0.0): isspace, NFKC, casefold and the formulation_key punctuation step identical, zero differences; with Python 3.11 (Unicode 14) there were 99 NFKC, 27 casefold and 36 punctuation differences, every one a scalar unassigned in Unicode 14"
   ],
   "proposed_resolution": "Applied 2026-10-09: the server runs CPython 3.14 and the Rust crates are pinned to the same Unicode 16.0.0, so Rust and the server are equal on every scalar. primitive-vectors.json records unidata_version and unicode_data rows, pinned by backend/tests/test_026_primitive_vectors.py and rust/crates/bb-domain/tests/primitives_parity.rs. Residual: Swift still uses the platform ICU/stdlib (its folding-exception table is the same set in Unicode 14 and 16); bump all runtimes together.",
   "status": "proposed"
  },
  {
   "id": "C-08",
   "topic": "Time zone database",
   "languages": {
    "python": "zoneinfo over the host tzdata",
    "swift": "Foundation TimeZone (OS tzdata)",
    "rust": "jiff-tzdb 0.1.9 bundled"
   },
   "evidence": [
    "same-data comparison: 103 747 (zone, day) rows over all 498 zones 1900..2045, 0 differences; bundled vs host tzdata differ on pre-1970 offsets and a few rule corrections (Bogota 1992, Tehran 1979, EET/WET 1977, Winnipeg 2026 in tzdata 2026c)"
   ],
   "proposed_resolution": "Logic is identical; data versions are not. Pin a tzdata release in server image, bridge and apps and expose it in capabilities.",
   "status": "decision-needed"
  },
  {
   "id": "C-09",
   "topic": "Start of a day when a DST gap straddles midnight",
   "languages": {
    "python": "datetime(y,m,d,tzinfo=zone).astimezone(UTC), fold=0: offset before the change",
    "swift": "first instant whose local date reaches the day (binary search)",
    "rust": "Python rule (jiff compatible)"
   },
   "evidence": [
    "only America/Toronto, Montreal, Nipigon, Thunder_Bay on 1919-03-31 (gap 23:30 to 00:30) differ across all of tzdata; every modern zone and every gap that starts at midnight agree"
   ],
   "proposed_resolution": "Server rule is normative; no current zone is affected.",
   "status": "proposed"
  },
  {
   "id": "C-10",
   "topic": "Range edges",
   "languages": {
    "python": "OverflowError for 0001-01-01 in zones east of UTC and for 9999-12-31 west of it",
    "swift": "clamps",
    "rust": "total: clamps"
   },
   "evidence": [
    "249 zone rows at 0001-01-01"
   ],
   "proposed_resolution": "Clamp; unreachable from real due dates.",
   "status": "proposed"
  }
