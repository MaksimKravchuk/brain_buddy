# Copy this file to `.env` before running docker-compose for smoke tests or the local stack.

# Backend configuration (mirrors compose defaults)
BRAIN_BUDDY_ENV=production
BRAIN_BUDDY_API_PREFIX=/api
BRAIN_BUDDY_LOG_LEVEL=INFO
BRAIN_BUDDY_DATA_DIR=/app/data
BRAIN_BUDDY_PORT=8000
# Uncomment to enforce API key auth for compose runs
# BRAIN_BUDDY_API_KEY=brainbuddy-smoke-key
BRAIN_BUDDY_API_KEY_HEADER=X-API-Key

# Frontend build-time variables (served at http://localhost:8080 in compose)
# Use /api so requests route through the frontend container's nginx to the backend service.
VITE_API_BASE_URL=/api
VITE_API_KEY=${BRAIN_BUDDY_API_KEY}
VITE_API_KEY_HEADER=${BRAIN_BUDDY_API_KEY_HEADER}
FRONTEND_PORT=8080

# Local host targets for tooling and smoke scripts
API_BASE_URL=http://localhost:${BRAIN_BUDDY_PORT}
API_PREFIX=${BRAIN_BUDDY_API_PREFIX}

# Compose defaults
COMPOSE_PROJECT_NAME=brain-buddy
