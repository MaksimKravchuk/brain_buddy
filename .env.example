# Copy this file to `.env` before running docker-compose for smoke tests or the local stack.

# Backend configuration (mirrors compose defaults)
# Use `development` for local compose over http://localhost so the session
# cookie is NOT emitted with the Secure flag — otherwise the browser will
# drop it over plain HTTP. Flip to `production` only when serving over HTTPS.
BRAIN_BUDDY_ENV=development
BRAIN_BUDDY_API_PREFIX=/api
BRAIN_BUDDY_LOG_LEVEL=INFO
BRAIN_BUDDY_DATA_DIR=/app/data
BRAIN_BUDDY_PORT=8000

# Voice Brain Dump accurate STT. Safe default is disabled unless this provider
# and its credential are configured. Never commit the key itself.
#
# Providers:
#   openai   -> model gpt-4o-mini-transcribe, credential OPENAI_API_KEY (default)
#   deepgram -> model nova-3 (multilingual, language=multi), credential
#               DEEPGRAM_API_KEY. Best for code-switched (e.g. RU+EN) speech.
# When PROVIDER=deepgram the MODEL and API_KEY_ENV defaults switch to nova-3 /
# DEEPGRAM_API_KEY automatically; set them explicitly only to override.
BRAIN_BUDDY_VOICE_ACCURATE_STT_PROVIDER=disabled
BRAIN_BUDDY_VOICE_ACCURATE_STT_MODEL=gpt-4o-mini-transcribe
BRAIN_BUDDY_VOICE_ACCURATE_STT_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
BRAIN_BUDDY_VOICE_ACCURATE_STT_TIMEOUT_SECONDS=180
BRAIN_BUDDY_VOICE_ACCURATE_STT_MAX_RETRIES=2
BRAIN_BUDDY_VOICE_ACCURATE_STT_RETRY_BACKOFF_SECONDS=1,2
BRAIN_BUDDY_VOICE_ACCURATE_STT_MAX_COST_USD=0.50
BRAIN_BUDDY_VOICE_ACCURATE_STT_ESTIMATED_COST_USD_PER_MB=0.01

# Web Task title autocomplete is OFF at rollout and provider-disabled by
# default. Enabling the runtime flag alone performs no egress. The OpenAI
# adapter always uses the official API origin and reads the named key from the
# process environment; never place the credential in source control.
BRAIN_BUDDY_TASK_TITLE_AUTOCOMPLETE_PROVIDER=disabled
BRAIN_BUDDY_TASK_TITLE_AUTOCOMPLETE_MODEL=gpt-4o-mini
BRAIN_BUDDY_TASK_TITLE_AUTOCOMPLETE_API_KEY_ENV=OPENAI_API_KEY

# Mixed-vendor pipelines are supported: consent names each configured role's
# provider category (e.g. deepgram STT + openai reconciler), so the accurate-STT
# and reconciler providers below may differ. The GET /brain-dump-providers
# endpoint reports the configured category per role and the client sends every
# one it needs in the consent it records.

# Voice semantic reconciliation is fail-closed by default. To enable the real
# text model, set the provider and supply OPENAI_API_KEY outside source control.
BRAIN_BUDDY_VOICE_RECONCILER_PROVIDER=disabled
BRAIN_BUDDY_VOICE_RECONCILER_MODEL=gpt-4o
BRAIN_BUDDY_VOICE_RECONCILER_API_KEY_ENV=OPENAI_API_KEY
BRAIN_BUDDY_VOICE_RECONCILER_ENDPOINT=https://api.openai.com/v1/chat/completions
BRAIN_BUDDY_VOICE_RECONCILER_TIMEOUT_SECONDS=30
BRAIN_BUDDY_VOICE_RECONCILER_MAX_RETRIES=2
BRAIN_BUDDY_VOICE_RECONCILER_RETRY_BACKOFF_SECONDS=1,2
BRAIN_BUDDY_VOICE_RECONCILER_MAX_COST_USD=0.50
BRAIN_BUDDY_VOICE_RECONCILER_ESTIMATED_COST_USD_PER_MB=0.01
# OPENAI_API_KEY=

# Operation-level voice safety limits. Per-role cost caps above bound one
# provider role; the cumulative cap includes every accurate-STT/reconciler
# attempt and recovery for one operation.
BRAIN_BUDDY_VOICE_MAX_OPERATION_RECOVERIES=2
BRAIN_BUDDY_VOICE_MAX_CUMULATIVE_COST_USD=1.00
BRAIN_BUDDY_VOICE_LEASE_RECOVERY_MARGIN_SECONDS=30

# Validate uploaded audio before a provider call. Production accepted MIME
# types exclude the test-only text fixture MIME type.
BRAIN_BUDDY_VOICE_AUDIO_ALLOWED_MIME_TYPES=audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/webm,audio/mp4,audio/aac
BRAIN_BUDDY_VOICE_AUDIO_MAX_CHUNK_BYTES=10485760
BRAIN_BUDDY_VOICE_AUDIO_MAX_TOTAL_BYTES=104857600
BRAIN_BUDDY_VOICE_AUDIO_MAX_CHUNK_COUNT=1024
BRAIN_BUDDY_VOICE_AUDIO_MAX_DURATION_SECONDS=1800
BRAIN_BUDDY_VOICE_AUDIO_ASSUMED_CHUNK_DURATION_SECONDS=5

# Retention and persisted-runner sweep. The sweep recovers expired leases and
# purges due raw audio/working artifacts; set its interval to 0 to disable the
# periodic thread (startup still runs one synchronous recovery/purge pass).
BRAIN_BUDDY_VOICE_RAW_AUDIO_RETENTION_SECONDS=86400
BRAIN_BUDDY_VOICE_WORKING_ARTIFACT_RETENTION_SECONDS=604800
BRAIN_BUDDY_VOICE_SWEEP_INTERVAL_SECONDS=60
# BRAIN_BUDDY_ENABLE_VOICE_SWEEP_IN_TEST=1

# ---------------------------------------------------------------------------
# External agent relay (spec 014, the A2A wire contract)
#
# The relay ships behind the SQLite-managed `external_agent_relay` flag, OFF by
# default. Turning it ON for any user is a release step with its own gate --
# see docs/external-agent-relay-release.md; it is never done by editing this
# file.
#
# BrainBuddy speaks A2A v1.0 JSON-RPC as a *client* only. There is no bespoke
# `/agent-events` callback any more and no `BRAIN_BUDDY_AGENT_EVENTS_*`
# variable: agents now reach BrainBuddy at exactly one inbound path, the push
# callback below, and a push only ever *accelerates* an observation BrainBuddy
# would perform anyway -- no state is ever read out of a push body.
# ---------------------------------------------------------------------------

# The origin agents call back to, and the backend app's *own* public origin --
# not the frontend's. It is baked into the per-run push callback URL
# {BRAIN_BUDDY_PUBLIC_BASE_URL}{api prefix}/a2a/push/{run_id}/{token}, which
# travels into a third-party system BrainBuddy does not control, so a wrong
# value is not recoverable by a later fix: agents already told to call
# somewhere else simply never arrive. Production additionally requires a
# canonical public HTTPS origin.
BRAIN_BUDDY_PUBLIC_BASE_URL=http://localhost:8000

# How long a tested connection stays fresh before it reads as stale and a
# hand-off is refused until it is tested again. Default 7 days.
BRAIN_BUDDY_AGENT_STALE_AFTER_SECONDS=604800

# How long a dispatched run may go without contact before its observation
# interval starts backing off geometrically (x2 per missed interval, capped at
# 10x the base interval). Default 1 hour.
BRAIN_BUDDY_AGENT_REPORTING_WINDOW_SECONDS=3600

# Content retention for relayed run content (manifest, progress, questions,
# results, failure reasons, artifact summaries). Hard maximum 30 days; the
# sweep nulls the content tier at this deadline while coarse metadata survives
# to identifier expiry. See docs/data-retention.md.
BRAIN_BUDDY_AGENT_CONTENT_RETENTION_SECONDS=2592000

# Relay privacy retention is deliberately independent from the optional voice
# runner. It always remains positive (1..3600 seconds); 0 is rejected so relay
# content cannot silently outlive its retention deadline when voice is disabled.
BRAIN_BUDDY_AGENT_RETENTION_SWEEP_INTERVAL_SECONDS=60

# Timeout for short calls: the card fetch, the connection test, observations
# and the control calls (cancel, push registration). Also the *connect* timeout
# of a blocking exchange. Maximum 120 s.
BRAIN_BUDDY_AGENT_CONNECTOR_TIMEOUT_SECONDS=10

# Byte cap on a card or short-call response body, enforced while streaming so
# an oversized answer is never fully allocated. 1024..1048576.
BRAIN_BUDDY_AGENT_CONNECTOR_MAX_RESPONSE_BYTES=64000

# The single governed opt-in that admits loopback/private destinations *and*
# plaintext HTTP. It exists for local development and for an operator
# deliberately pointing BrainBuddy at an agent inside their own network.
# MUST stay off in production: with it on, a hostname that resolves inward
# turns the relay into an internal-network client.
BRAIN_BUDDY_AGENT_ALLOW_PRIVATE_DESTINATIONS=false

# --- Observation schedule and the three bounded worker pools (014) ----------
#
# The pools are separate on purpose. A cancel shares nothing with the blocking
# exchanges it is meant to end, and an observation never waits behind one, so a
# saturated exchange pool cannot make a healthy agent look silent.

# Base interval between scheduled observations of a dispatched, non-terminal
# run. A minimum, never a promise: backoff and pool contention may stretch it.
# 5..3600 seconds.
BRAIN_BUDDY_AGENT_OBSERVATION_INTERVAL_SECONDS=60

# How long BrainBuddy waits for an agent to answer a blocking SendMessage.
# Never below 300 s -- shortening it would make BrainBuddy the party that gave
# up first while the UI told the user the agent had. 300..3600 seconds.
BRAIN_BUDDY_AGENT_REPLY_WINDOW_SECONDS=300

# How long the API thread waits for a submitted exchange before answering. On
# expiry the response is an honest projection -- "Queued" while nothing has
# left BrainBuddy, "Sent" only once a worker actually started the exchange.
# 0..30 seconds.
BRAIN_BUDDY_AGENT_DISPATCH_WAIT_SECONDS=5

# Exchange pool: blocking SendMessage starts and replies only. 1..64.
BRAIN_BUDDY_AGENT_EXCHANGE_WORKERS=8

# Exchange workers one connection may hold at once; further exchanges stay
# queued. This is what stops one hostile or broken agent from exhausting the
# shared pool for every owner. 1..BRAIN_BUDDY_AGENT_EXCHANGE_WORKERS.
BRAIN_BUDDY_AGENT_MAX_EXCHANGES_PER_CONNECTION=2

# Observation pool: GetTask/ListTasks. Separate from the exchange pool. 1..64.
BRAIN_BUDDY_AGENT_OBSERVER_WORKERS=4

# Control pool: CancelTask and push-config registration, short timeout, never
# shared with start/reply exchanges. 1..16.
BRAIN_BUDDY_AGENT_CONTROL_WORKERS=2

# Byte cap on a GetTask/ListTasks response. Larger than the card cap because
# GetTask has no `includeArtifacts` switch. An over-cap GetTask falls back to
# ListTasks without artifacts, so the state is still observed and the run is
# marked "too large" rather than drifting into "Stopped reporting".
# 1024..1048576 (1 MiB hard maximum).
BRAIN_BUDDY_AGENT_A2A_TASK_MAX_RESPONSE_BYTES=262144

# Server-owned feature flags. Allow-listed in code (app/core/config.py,
# KNOWN_FEATURE_FLAGS); every flag defaults to off and invalid configuration
# fails startup. States: off | internal | on. INTERNAL is visible only to the
# allow-listed cohort below. Flags gate exposure, never authorization.
#
# BRAIN_BUDDY_FEATURE_FLAGS only controls delivery_canary (verified-trunk
# release canary, ADR-0008) at runtime — that is the sole flag this
# configuration still resolves on every request.
# Example: BRAIN_BUDDY_FEATURE_FLAGS=delivery_canary=internal
#
# voice_brain_dump (ADR-0008), mobile_task_classification (spec 006, FR-015)
# and external_agent_relay (ADR-0008) are the three SQLite-managed flags
# (ADR-0019): after the one-time migration on first startup, they are
# managed exclusively through the Admin Portal's SQLite-backed store, never
# through this variable again. Setting them here (e.g.
# voice_brain_dump=on) only matters the first time a fresh database is
# created, as migration seed input — it is inert on every startup after
# that. Local dev typically seeds voice_brain_dump=on this way once (see the
# gitignored .env).
BRAIN_BUDDY_FEATURE_FLAGS=
# Comma-separated emails. Two roles: (1) the runtime INTERNAL-stage cohort
# for delivery_canary — evaluated on every request; and (2) one-time
# migration input for the three SQLite-managed flags above, resolving their
# pre-migration `internal` stage into the seeded selected-users cohort by
# current account id (an email that no longer resolves is skipped, never
# substituted). In production this MUST include BRAIN_BUDDY_ADMIN_EMAIL: the
# deploy preflight (scripts/check_smoke_identity_cohort.py) fails closed
# otherwise, because the smoke user could never pass the delivery_canary
# assertion.
BRAIN_BUDDY_FEATURE_FLAG_INTERNAL_USERS=

# The production smoke identity is the seeded admin account: the deploy
# workflow stages BRAIN_BUDDY_ADMIN_EMAIL / BRAIN_BUDDY_ADMIN_PASSWORD /
# BRAIN_BUDDY_FEATURE_FLAG_INTERNAL_USERS (GitHub production environment
# secrets) plus BRAIN_BUDDY_FEATURE_FLAGS=delivery_canary=internal into the
# Fly backend, and scripts/production_smoke.sh logs in with the same values.
# Never store real values in this file.

# Optional: seed an admin account on startup (bypasses the invite flow).
# Set BOTH to enable. If the account already exists, the password is
# rotated to match the env var on every startup.
# In production this seeded account is also the sole admin-portal operator
# (see below), so BRAIN_BUDDY_ADMIN_PASSWORD is an admin-grade credential —
# a leak of it is a leak of cross-account lookup and session revoke, not just
# of one member account. See docs/auth.md.
# BRAIN_BUDDY_ADMIN_EMAIL=you@example.com
# BRAIN_BUDDY_ADMIN_PASSWORD=a-long-random-password

# Comma-separated emails authorized for the /admin portal (spec 009,
# 009-FR-001): exact account lookup by id or canonical email, and revoke-all-
# sessions for any account. This is authorization, not a feature-flag cohort —
# it is deliberately separate from BRAIN_BUDDY_FEATURE_FLAG_INTERNAL_USERS.
#   - Values are normalized (trimmed, lowercased) and must look like emails;
#     an entry without "@" fails startup rather than being ignored.
#   - Empty (the default) fails closed: nobody is an operator and /admin is
#     unreachable. That is an operations gap, never an open door.
#   - Each listed address must belong to an existing account, and is treated
#     as reserved: signup and self-serve email change refuse it, so operator
#     authority cannot be self-claimed by moving an account onto it. Only the
#     BRAIN_BUDDY_ADMIN_EMAIL seed path may provision the configured identity.
#   - In production the deploy workflow pins this to BRAIN_BUDDY_ADMIN_EMAIL
#     and restages it on every release, so a manual `flyctl secrets set` here
#     is reverted by the next deploy.
BRAIN_BUDDY_ADMIN_OPERATOR_EMAILS=

# Frontend build-time variables (served at http://localhost:8080 in compose)
# Use /api so requests route through the frontend container's nginx to the backend service.
VITE_API_BASE_URL=/api
FRONTEND_PORT=8080
# Host port the Hermes A2A E2E fixture is published on. Only used by the
# `agents` Compose profile, and only so a test runner on the host can talk to
# the fixture directly; the agent card still advertises `hermes-a2a:9900`,
# which is the address the backend container reaches it on.
BRAIN_BUDDY_HERMES_A2A_PORT=9900
# Dev server host ports (used by make dev-frontend)
FRONTEND_DEV_PORT=5173
# Uncomment to use an alternate host port for the dev server
# FRONTEND_ALT_PORT=3000

# Local host targets for tooling and smoke scripts
API_BASE_URL=http://localhost:${BRAIN_BUDDY_PORT}
API_PREFIX=${BRAIN_BUDDY_API_PREFIX}

# Compose defaults
COMPOSE_PROJECT_NAME=brain-buddy
