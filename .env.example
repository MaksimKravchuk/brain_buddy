# Copy this file to `.env` before running docker-compose for smoke tests or the local stack.

# Backend configuration (mirrors compose defaults)
# Use `development` for local compose over http://localhost so the session
# cookie is NOT emitted with the Secure flag — otherwise the browser will
# drop it over plain HTTP. Flip to `production` only when serving over HTTPS.
BRAIN_BUDDY_ENV=development
BRAIN_BUDDY_API_PREFIX=/api
BRAIN_BUDDY_LOG_LEVEL=INFO
BRAIN_BUDDY_DATA_DIR=/app/data
BRAIN_BUDDY_PORT=8000

# Voice semantic reconciliation is fail-closed by default. To enable the real
# text model, set the provider and supply OPENAI_API_KEY outside source control.
BRAIN_BUDDY_VOICE_RECONCILER_PROVIDER=disabled
BRAIN_BUDDY_VOICE_RECONCILER_MODEL=gpt-4o
BRAIN_BUDDY_VOICE_RECONCILER_TIMEOUT_SECONDS=30
# OPENAI_API_KEY=

# Optional: seed an admin account on startup (bypasses the invite flow).
# Set BOTH to enable. If the account already exists, the password is
# rotated to match the env var on every startup.
# BRAIN_BUDDY_ADMIN_EMAIL=you@example.com
# BRAIN_BUDDY_ADMIN_PASSWORD=a-long-random-password

# Frontend build-time variables (served at http://localhost:8080 in compose)
# Use /api so requests route through the frontend container's nginx to the backend service.
VITE_API_BASE_URL=/api
FRONTEND_PORT=8080
# Dev server host ports (used by make dev-frontend)
FRONTEND_DEV_PORT=5173
# Uncomment to use an alternate host port for the dev server
# FRONTEND_ALT_PORT=3000

# Local host targets for tooling and smoke scripts
API_BASE_URL=http://localhost:${BRAIN_BUDDY_PORT}
API_PREFIX=${BRAIN_BUDDY_API_PREFIX}

# Compose defaults
COMPOSE_PROJECT_NAME=brain-buddy
