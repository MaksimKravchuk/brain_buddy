{
  "expo": {
    "name": "Brain Buddy",
    "slug": "brain-buddy",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "brainbuddy",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.brainbuddy.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Brain Buddy records audio only while you hold a brain dump session. Nothing is saved until you stop."
      }
    },
    "android": {
      "package": "com.brainbuddy.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0EA5E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Brain Buddy records audio only while you hold a brain dump session. Nothing is saved until you stop."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
