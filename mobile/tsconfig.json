{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/api/**/*.ts",
    "src/auth/**/*.ts",
    "src/auth/**/*.tsx",
    "src/design/**/*.ts",
    "src/features/**/*.ts",
    "src/features/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["**/__tests__/**", "src/test/**"]
}
